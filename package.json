{
  "name": "@zakkster/lite-gl",
  "version": "1.4.1",
  "description": "Signal-native instanced primitive renderer: project ~1M points/quads/lines from reactive inputs, upload only what changed, draw in one instanced call. Deep-zoom precision via a GPU camera with double-emulated world coordinates. Zero-GC core + a browser WebGL2 backend.",
  "type": "module",
  "main": "./GL.js",
  "module": "./GL.js",
  "types": "./GL.d.ts",
  "exports": {
    ".": {
      "types": "./GL.d.ts",
      "node": "./GL.js",
      "import": "./GL.js",
      "default": "./GL.js"
    },
    "./backend": {
      "types": "./GLBackend.d.ts",
      "node": "./GLBackend.js",
      "import": "./GLBackend.js",
      "default": "./GLBackend.js"
    }
  },
  "sideEffects": false,
  "files": [
    "GL.js",
    "GL.d.ts",
    "GLBackend.js",
    "GLBackend.d.ts",
    "README.md",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE.txt"
  ],
  "scripts": {
    "test": "node --test test/GL_test.mjs test/GLBackend_test.mjs test/packaging_test.mjs",
    "pretest:torture": "npm install @zakkster/lite-signal@1.5.0-beta.7 --prefix node_modules/@zakkster/lite-leak --no-save --no-audit --no-fund --legacy-peer-deps",
    "test:torture": "node --expose-gc test/torture.mjs",
    "test:smoke": "playwright test test/smoke.spec.mjs"
  },
  "peerDependencies": {
    "@zakkster/lite-raf": "^1.0.0",
    "@zakkster/lite-signal": ">=1.5.0-alpha"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@zakkster/lite-gc-profiler": "^1.15.0",
    "@zakkster/lite-leak": "^1.8.1",
    "@zakkster/lite-raf": "^1.1.0",
    "@zakkster/lite-signal": ">=1.6.0-preview.2"
  },
  "overrides": {
    "@zakkster/lite-raf": {
      "@zakkster/lite-signal": "$@zakkster/lite-signal"
    },
    "@zakkster/lite-leak": {
      "@zakkster/lite-signal": "1.5.0-beta.7"
    }
  },
  "keywords": [
    "webgl",
    "webgl2",
    "instanced",
    "renderer",
    "chart",
    "points",
    "scatter",
    "quads",
    "bars",
    "zero-gc",
    "reactive",
    "signals",
    "gpu",
    "esm",
    "lite-signal",
    "deep-zoom",
    "precision",
    "float32",
    "time-series",
    "relative-to-eye"
  ],
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-gl.git"
  },
  "homepage": "https://github.com/PeshoVurtoleta/lite-gl#readme",
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-gl/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
